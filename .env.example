# Root-level example for docker-compose.yml. Copy to .env if you need to
# override these for `docker compose up`; neither project needs API keys or
# credentials of any kind.

# Comma-separated list of origins the backend will accept CORS requests from.
CORS_ORIGINS=http://localhost:3000

# Base URL the frontend uses to reach the backend, baked in at frontend build time.
VITE_API_BASE_URL=http://localhost:8000

# AutoTopic: where the real labeled dataset (~118MB parquet, too large for git)
# is loaded from -- a path relative to AutoTopic/, or an http(s) URL (Google
# Drive direct-download link). See AutoTopic/data/README.md and backend/.env.example.
# REPLACE with the actual Google Drive share link once uploaded there.
AUTOTOPIC_DATA_URL=data/raw/labeled_requests.parquet
