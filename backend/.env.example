# Copy to .env for a non-Docker `uvicorn app.main:app` run, or set these as
# real environment variables. No API keys or credentials are needed by any
# of the three projects.

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# AutoTopic: caps corpus size per /api/autotopic/analyze request so BERTopic
# stays fast on CPU.
AUTOTOPIC_MAX_DOCUMENTS=500

# AutoTopic: where the real labeled dataset (~118MB parquet, too large for
# git -- see AutoTopic/data/README.md) is loaded from. Used by
# POST /api/autotopic/analyze-dataset. Accepts either a path relative to
# AutoTopic/ (default below -- the file already lives there locally) or an
# http(s) URL (a Google Drive *direct-download* link), downloaded and cached
# on first use.
# REPLACE THIS with the real Google Drive share link once the file is uploaded there.
AUTOTOPIC_DATA_URL=data/raw/labeled_requests.parquet

# ECG: caps .npy upload size for /api/ecg/analyze.
ECG_MAX_UPLOAD_BYTES=2097152
